{
  "name": "agentoffice",
  "version": "1.0.0",
  "description": "AI Agent Control Tower - Manage multiple AI agents from a single interface",
  "type": "module",
  "main": "index.js",
  "bin": {
    "agentoffice": "./cli/index.ts"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "tsx watch server/src/app.ts",
    "dev:web": "vite --host",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node cli/index.ts"
  },
  "keywords": ["ai", "agents", "claude", "control", "office"],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "fastify-websocket": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
